# Contributor: Bartłomiej Piotrowski <bpiotrowski@archlinux.org>
# Contributor: xduugu
# Contributor: Elis Hughes <elishughes@googlemail.com>

pkgname=rtmpdump
pkgver=2.6
pkgrel=2
epoch=1
pkgdesc='A toolkit for RTMP streams'
arch=(x86_64)
url=https://rtmpdump.mplayerhq.hu/
license=(
  GPL-2.0-only
  LGPL-2.1-only
)
depends=(
  glibc
  gnutls
  zlib
)
provides=(librtmp.so)
# kashira: git.ffmpeg.org no longer serves the pinned ref; use Debian's 2.6 tarball
source=(rtmpdump-$pkgver.tar.xz::https://deb.debian.org/debian/pool/main/r/rtmpdump/rtmpdump_$pkgver.orig.tar.xz
        nettle-4.patch)
sha256sums=('f88e141ea3e126574dce24dca364f209560e13097fbba9c7f6b2f47a9a167646'
            'b9cbbcf14d9fb46962d541544f47226909a7bc7191e2be50cfd0c73c73c4b80d')

prepare() {
  cd rtmpdump-$pkgver
  patch -p1 -i ../nettle-4.patch
}

build() {
  cd rtmpdump-$pkgver
  sed -e 's/^CRYPTO=OPENSSL/#CRYPTO=OPENSSL/' -e 's/#CRYPTO=GNUTLS/CRYPTO=GNUTLS/' -i Makefile -i librtmp/Makefile
  make \
    OPT="$CFLAGS" \
    XLDFLAGS="$LDFLAGS"
}

package() {
  cd rtmpdump-$pkgver
  make \
    prefix=/usr \
    sbindir=/usr/bin \
    mandir=/usr/share/man \
    DESTDIR="${pkgdir}" \
    install
}

