# kashira: shadow — password and account management tool suite
# upstream: https://github.com/shadow-maint/shadow

pkgname=shadow
pkgver=4.20.2
pkgrel=1
pkgdesc='Password and account management tool suite with shadow file support'
arch=('x86_64')
url='https://github.com/shadow-maint/shadow'
license=('BSD-3-Clause')
depends=('acl' 'attr' 'glibc' 'libxcrypt' 'audit' 'pam')
backup=('etc/login.defs')
install=shadow.install
source=("$url/releases/download/$pkgver/$pkgname-$pkgver.tar.xz")
sha256sums=('b89f432b75ae55a2d852b446d0365484795fdf533ab97d550e325fa15594a224')

prepare() {
  cd "$pkgname-$pkgver"

  # these manual pages are already provided by man-pages
  find man -name Makefile.in -exec sed -i 's/getspnam\.3 / /' {} \;
  find man -name Makefile.in -exec sed -i 's/passwd\.5 / /'   {} \;

  # default to the YESCRYPT password hash, keep mail in /var/mail, and drop
  # /bin and /sbin from the default PATH (both are symlinks into /usr)
  sed -e 's:#ENCRYPT_METHOD SHA512:ENCRYPT_METHOD YESCRYPT:' \
      -e 's:/var/spool/mail:/var/mail:'                      \
      -e '/PATH=/{s@/sbin:@@;s@/bin:@@}'                     \
      -i etc/login.defs
}

build() {
  cd "$pkgname-$pkgver"

  # sbindir=/usr/bin: merged-/usr layout has no separate sbin
  # --disable-logind: login/who fall back to /run/utmp; shadow is built
  # before systemd in the bootstrap order, same as in the LFS book
  ./configure --prefix=/usr   \
      --host="$CHOST" \
      --bindir=/usr/bin \
      --sbindir=/usr/bin \
      --sysconfdir=/etc \
      --disable-static  \
      --with-bcrypt     \
      --with-yescrypt   \
      --without-libbsd  \
      --disable-logind  \
      --with-group-name-max-length=32
  # upstream configure.ac force-empties exec_prefix when prefix=/usr (legacy
  # /lib + /usr/sbin placement); put it back for the merged-/usr layout
  make exec_prefix=/usr
}

package() {
  cd "$pkgname-$pkgver"

  # shadow's install script hardcodes /usr/bin/passwd and creates it in the
  # wrong place if it does not already exist
  install -dm755 "$pkgdir/usr/bin"
  touch "$pkgdir/usr/bin/passwd"

  make DESTDIR="$pkgdir" exec_prefix=/usr usbindir=/usr/bin install
  make DESTDIR="$pkgdir" -C man install-man

  # pam.d services come from util-linux/pambase on Arch; shadow shipping its
  # own conflicts with util-linux (chfn/chsh/login/su/su-l)
  rm -rf "$pkgdir/etc/pam.d"

  # su is util-linux's (Arch parity); shadow's build drops one too
  rm -f "$pkgdir/usr/bin/su" "$pkgdir/usr/share/man/man1/su.1" \
        "$pkgdir"/usr/share/man/*/man1/su.1*

  install -Dm644 COPYING "$pkgdir/usr/share/licenses/$pkgname/COPYING"
}
