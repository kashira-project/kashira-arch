# kashira bootstrap recipe: wheel install (breaks the source-build cycle
# python-build <-> python-flit-core <-> python-installer). Wheel contents are
# the same pure-python payload; a from-source rebuild pass can retire this.
pkgname=python-build
pkgver=1.6.0
pkgrel=1
pkgdesc='A simple, correct Python build frontend'
arch=('any')
url='https://pypi.org/project/build'
license=('MIT')
depends=('python' 'python-packaging' 'python-pyproject-hooks')
makedepends=()
source=("https://files.pythonhosted.org/packages/ab/e5/aa1e81b21aea0ce0ba435311837a37d4cb936e7461f9fecac08580073ba9/build-1.6.0-py3-none-any.whl")
sha256sums=('f7aaf1ebbb79178a02ba248bb524f2176b256017e17e8e4bd4289c7b38cc2bad')

package() {
  # wheels are zips laid out as site-packages
  install -dm755 "$pkgdir/usr/lib/python3.14/site-packages"
  python -m zipfile -e "$srcdir/build-1.6.0-py3-none-any.whl" "$pkgdir/usr/lib/python3.14/site-packages/"
}
