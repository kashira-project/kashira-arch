# kashira: perl — Practical Extraction and Report Language
# upstream: https://www.perl.org/
pkgname=perl
pkgver=5.44.0
_perlver=${pkgver%.*}
pkgrel=2
pkgdesc='Practical extraction and report language interpreter and core modules'
arch=('x86_64')
url='https://www.perl.org/'
license=('Artistic-1.0-Perl' 'GPL-1.0-or-later')
# GDBM_File links gdbm, crypt() links libxcrypt, DB_File links db5.3;
# BUILD_ZLIB/BUILD_BZIP2 below make the bundled IO::Compress modules link
# the system zlib-ng and bzip2.
depends=('glibc' 'gdbm' 'db5.3' 'libxcrypt' 'zlib-ng' 'bzip2')
# Configure only builds DB_File when it finds <db.h> and -ldb at build time
makedepends=('db5.3')
source=("https://www.cpan.org/src/5.0/perl-$pkgver.tar.xz")
sha256sums=('505cf43912e9480495c344c70260452e32aa2a73c546a026b3f100053b23ce91')

build() {
  cd "$pkgname-$pkgver"

  # use the system zlib-ng/bzip2 for Compress::Raw::Zlib / Compress::Raw::BZip2
  # instead of the copies vendored in the perl tree
  export BUILD_ZLIB=False
  export BUILD_BZIP2=0

  # -Dcc=clang + -Accflags: Configure recognises the compiler by probing for
  # gcc; aimed at clang it misses the family and silently drops
  # -fno-strict-aliasing -fwrapv from ccflags. Perl core relies on both —
  # without them strict-aliasing miscompiles show up as runtime panics
  # (magic_killbackrefs). Pick clang explicitly and hand the flags back.
  sh Configure -des \
    -D prefix=/usr \
    -D vendorprefix=/usr \
    -D privlib="/usr/lib/perl5/$_perlver/core_perl" \
    -D archlib="/usr/lib/perl5/$_perlver/core_perl" \
    -D sitelib="/usr/lib/perl5/$_perlver/site_perl" \
    -D sitearch="/usr/lib/perl5/$_perlver/site_perl" \
    -D vendorlib="/usr/lib/perl5/$_perlver/vendor_perl" \
    -D vendorarch="/usr/lib/perl5/$_perlver/vendor_perl" \
    -D man1dir=/usr/share/man/man1 \
    -D man3dir=/usr/share/man/man3 \
    -D pager="/usr/bin/less -isR" \
    -D useshrplib \
    -D usethreads \
    -D cc=clang \
    -Accflags='-fno-strict-aliasing -fwrapv' \
    -D locincpth=/usr/include/db5.3 \
    -D loclibpth=/usr/lib/db5.3

  make
}

package() {
  cd "$pkgname-$pkgver"
  make DESTDIR="$pkgdir" install
}
