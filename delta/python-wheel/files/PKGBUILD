# kashira bootstrap recipe: wheel install (breaks the source-build cycle
# python-build <-> python-flit-core <-> python-installer). Wheel contents are
# the same pure-python payload; a from-source rebuild pass can retire this.
pkgname=python-wheel
pkgver=0.48.0
pkgrel=1
pkgdesc='Command line tool for manipulating wheel files'
arch=('any')
url='https://pypi.org/project/wheel'
license=('MIT')
depends=('python')
makedepends=()
source=("https://files.pythonhosted.org/packages/2e/29/69cfbb602cd91690c55d38ba9fe53e6a7e76a6fa647bf38f19c138d25449/wheel-0.48.0-py3-none-any.whl")
sha256sums=('3217dcc807155e45db462d7ef2431f5ddda0d7273b700d05a67b271ceb1287ab')

package() {
  # wheels are zips laid out as site-packages
  install -dm755 "$pkgdir/usr/lib/python3.14/site-packages"
  python -m zipfile -e "$srcdir/wheel-0.48.0-py3-none-any.whl" "$pkgdir/usr/lib/python3.14/site-packages/"
}
