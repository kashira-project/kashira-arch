# kashira bootstrap recipe: wheel install (breaks the source-build cycle
# python-build <-> python-flit-core <-> python-installer). Wheel contents are
# the same pure-python payload; a from-source rebuild pass can retire this.
pkgname=python-installer
pkgver=1.0.1
pkgrel=1
pkgdesc='A library for installing Python wheels.'
arch=('any')
url='https://pypi.org/project/installer'
license=('MIT')
depends=('python')
makedepends=()
source=("https://files.pythonhosted.org/packages/26/48/bedf3ba4163e7db392c9d4cbdfc8217423196c8fccbe5a404a0f094fde63/installer-1.0.1-py3-none-any.whl")
sha256sums=('011d045df8b954ced7dde3a7e42ae4418da40ecda7990f2d11d5ed7c146fd98b')

package() {
  # wheels are zips laid out as site-packages
  install -dm755 "$pkgdir/usr/lib/python3.14/site-packages"
  python -m zipfile -e "$srcdir/installer-1.0.1-py3-none-any.whl" "$pkgdir/usr/lib/python3.14/site-packages/"
}
