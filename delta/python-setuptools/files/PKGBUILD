# kashira bootstrap recipe: wheel install (breaks the source-build cycle
# python-build <-> python-flit-core <-> python-installer). Wheel contents are
# the same pure-python payload; a from-source rebuild pass can retire this.
pkgname=python-setuptools
pkgver=84.0.0
pkgrel=1
pkgdesc='Most extensible Python build backend with support for C/C++ extension modules'
arch=('any')
url='https://pypi.org/project/setuptools'
license=('MIT')
depends=('python')
makedepends=()
source=("https://files.pythonhosted.org/packages/95/9c/c510029fc6ef33a6275cd2c5d3cecd6613dfd6aa401d57c54f1c18852ccf/setuptools-84.0.0-py3-none-any.whl")
sha256sums=('51a52592b3b99e102b609654876bd65f19f999935166d1352678931132b0c670')

package() {
  # wheels are zips laid out as site-packages
  install -dm755 "$pkgdir/usr/lib/python3.14/site-packages"
  python -m zipfile -e "$srcdir/setuptools-84.0.0-py3-none-any.whl" "$pkgdir/usr/lib/python3.14/site-packages/"
}
