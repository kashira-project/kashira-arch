+        'SKIP')
 
 prepare() {
   cd $pkgname-$pkgver
+  # kashira: SDL is not packaged; drop the AM_PATH_SDL check so autoreconf
+  # works without sdl.m4 (its overquoted AC_DEFINE action breaks autoconf 2.73)
+  patch -Np1 -i "$srcdir/libdv-1.0.0-no-sdl.patch"
   autoreconf -fiv
 }
 
 build() {
   cd $pkgname-$pkgver
+  CFLAGS+=" -std=gnu89 -Wno-implicit-function-declaration -Wno-implicit-int -Wno-int-conversion"
   ./configure \
     --prefix=/usr \
     --sysconfdir=/etc \
     --localstatedir=/var \
-    --disable-gtk
+    --disable-gtk \
+    --disable-sdl
   make
 }
 
