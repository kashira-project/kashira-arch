# kashira bootstrap recipe: wheel install (breaks the source-build cycle
# python-build <-> python-flit-core <-> python-installer). Wheel contents are
# the same pure-python payload; a from-source rebuild pass can retire this.
pkgname=python-pyproject-hooks
pkgver=1.2.0
pkgrel=1
pkgdesc='Wrappers to call pyproject.toml-based build backend hooks.'
arch=('any')
url='https://pypi.org/project/pyproject_hooks'
license=('MIT')
depends=('python')
makedepends=()
source=("https://files.pythonhosted.org/packages/bd/24/12818598c362d7f300f18e74db45963dbcb85150324092410c8b49405e42/pyproject_hooks-1.2.0-py3-none-any.whl")
sha256sums=('9e5c6bfa8dcc30091c74b0cf803c81fdd29d94f01992a7707bc97babb1141913')

package() {
  # wheels are zips laid out as site-packages
  install -dm755 "$pkgdir/usr/lib/python3.14/site-packages"
  python -m zipfile -e "$srcdir/pyproject_hooks-1.2.0-py3-none-any.whl" "$pkgdir/usr/lib/python3.14/site-packages/"
}
