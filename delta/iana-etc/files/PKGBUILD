# kashira: iana-etc — /etc/protocols and /etc/services from IANA data
# upstream: https://github.com/Mic92/iana-etc

pkgname=iana-etc
pkgver=20260805
pkgrel=1
pkgdesc='IANA protocol numbers and service port assignments for /etc'
arch=('any')
url='https://www.iana.org/protocols'
license=('custom:none')
# local edits to these registries must survive package upgrades
backup=('etc/protocols' 'etc/services')
source=("https://github.com/Mic92/iana-etc/releases/download/$pkgver/$pkgname-$pkgver.tar.gz")
sha256sums=('29270860664e324107537f32ea476a333ca52d71b59c74bc06ecc3b0fa9cf490')

package() {
  cd "$pkgname-$pkgver"

  # data-only package: the tarball already contains the generated registries
  install -Dm644 -t "$pkgdir/etc" protocols services
}
